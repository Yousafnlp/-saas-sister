{
  "name": "daesthetics",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @daesthetics/api\" \"npm run dev -w @daesthetics/web\"",
    "dev:web": "npm run dev -w @daesthetics/web",
    "dev:api": "npm run dev -w @daesthetics/api",
    "build": "npm run build -w @daesthetics/web",
    "lint": "npm run lint -w @daesthetics/web",
    "seed": "npm run seed -w @daesthetics/api",
    "dev:site": "npm run dev -w @daesthetics/site",
    "build:site": "npm run build -w @daesthetics/site"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
