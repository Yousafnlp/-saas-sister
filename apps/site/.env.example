# Copy to .env.local (or set these in your hosting dashboard).

# Where demo requests go. WhatsApp number in international format, digits only (Pakistan: 92 + number without the leading 0).
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# Public address of this website, used for share previews and the sitemap. On Vercel it is filled in automatically.
NEXT_PUBLIC_SITE_URL=

# Where customers sign in to their clinic. Leave empty to hide the "Sign in" link.
NEXT_PUBLIC_APP_URL=
